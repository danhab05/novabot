# Novabot configuration.
# Copy to ~/.novabot/secrets.env (chmod 600). scripts/install.sh does this for you.
# Real environment variables override this file. Never commit the real file.
#
# [required] = Novabot will not be usable without it.
# [generated] = scripts/install.sh (or the daemon on first start) fills it in.
# everything else is optional.

# ---------------------------------------------------------------- core
# [required] Public HTTPS URL of the PWA (behind your reverse proxy). Used for OAuth redirects and links.
NOVABOT_PUBLIC_URL=https://novabot.example.com
# Interface/port the daemon listens on. Keep 127.0.0.1 behind a reverse proxy.
# Use the docker bridge IP (e.g. 172.17.0.1) if agents/containers must reach the daemon.
NOVABOT_HOST=127.0.0.1
NOVABOT_PORT=8790
# [generated] Internal token: MCP server -> daemon, emergency login (/auth/dev?token=...), encryption key of OAuth tokens.
NOVABOT_INTERNAL_TOKEN=
# Your first name, used in prompts and messages ("Owner" if empty).
NOVABOT_OWNER_NAME=Owner
# One line about you, appended to the brain's system prompt (e.g. "developer, runs a small agency").
NOVABOT_OWNER_ABOUT=
# Language the assistant and agents answer in (prompts are written in French).
NOVABOT_LANGUAGE=français
# Time zone for crons, the morning brief and "times I give you".
NOVABOT_TZ=Europe/Paris
# Data directory (DB, uploads, handoffs, worktrees). Default: ~/.novabot
# NOVABOT_DATA=
# NOVABOT_DB=            # default: $NOVABOT_DATA/novabot.db
# NOVABOT_SECRETS=       # this file; default: $NOVABOT_DATA/secrets.env
# NOVABOT_PWA_DIST=      # default: apps/pwa/dist
# Comma-separated list of modules to disable (brain, herdr, browser, proactive, catalog, discord, importer...).
# NOVABOT_DISABLE=
# NOVABOT_DEV=1          # dev mode (non-secure cookies)

# ---------------------------------------------------------------- Discord (login + channels)
# [required] Your Discord user id (Developer Mode -> right click on yourself -> Copy User ID). Only this account is admin.
NOVABOT_ADMIN_DISCORD_ID=
# [required] Bot token (Developer Portal -> Bot -> Reset Token).
DISCORD_BOT_TOKEN=
# [required] OAuth2 client id / secret (Developer Portal -> OAuth2). Redirect URI: <NOVABOT_PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# [required] Id of the Discord server (guild) where Novabot creates one channel per project.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------- Web Push
# [generated] VAPID keys for PWA notifications (generated and appended on first start if empty).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------- Google (Gmail, Calendar, Drive) — optional
# OAuth client "Web application", redirect URI: <NOVABOT_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Yahoo Mail (IMAP) — optional
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# ---------------------------------------------------------------- WhatsApp — optional
# Command of a local WhatsApp bridge CLI (subcommands: latest, unread, search, send, status; JSON output).
# NOVABOT_WHATSAPP_CMD=wa

# ---------------------------------------------------------------- Coolify (deploy status + health) — optional
# COOLIFY_URL=https://coolify.example.com
# COOLIFY_TOKEN=
# COOLIFY_TOKEN_FILE=~/.coolify-api-token     # alternative to COOLIFY_TOKEN (default path)
# Preview/test domains to skip for HTTP checks (suffix), e.g. .preview.example.com
# COOLIFY_IGNORE_DOMAIN_SUFFIX=
# Coolify app name -> Novabot project id, when they differ: "app-a=project-a,app-b=project-b"
# NOVABOT_COOLIFY_APP_MAP=

# ---------------------------------------------------------------- health monitoring — optional
# Extra URLs to probe every 5 min (comma-separated). Project notes can also contain "url: https://..."
# and "services: nginx, my-container" lines (systemd units or docker containers).
# NOVABOT_HEALTH_URLS=https://status.example.com

# ---------------------------------------------------------------- brain / agents — optional
# Codex (ChatGPT subscription) reads its OAuth credentials from $CODEX_HOME/auth.json (default ~/.codex).
# CODEX_HOME=
# Claude uses the `claude` CLI already logged in (claude -p). Nothing to set here.
# Global rules file injected into the brain's context (default ~/AGENTS.md, skipped if missing).
# NOVABOT_GLOBAL_RULES_FILE=
# Script printing quota lines "<tool> <window> <used%> <resets_at_epoch> <age_s>" (skipped if missing).
# NOVABOT_QUOTA_SCRIPT=
# Shared Chrome (CDP) used by the live browser panel and the Playwright MCP.
# NOVABOT_CDP_URL=http://127.0.0.1:9222
# NOVABOT_PLAYWRIGHT_OUTPUT_DIR=~/.playwright-mcp
# Herdr agent limits (JSON). Defaults: {"memMb":3072,"swapPct":75,"load":6,"maxParallel":4}.
# A "herdr.limits" row in the settings table overrides this.
# NOVABOT_HERDR_LIMITS={"maxParallel":2}

# ---------------------------------------------------------------- voice — optional
# NOVABOT_VENV=~/.novabot/venv       # python venv with faster-whisper + edge-tts
# NOVABOT_STT_MODEL=small
# NOVABOT_STT_THREADS=4
# NOVABOT_TTS_VOICE=fr-FR-RemyMultilingualNeural

# ---------------------------------------------------------------- catalog / skills — optional
# NOVABOT_CLAUDE_SKILLS_DIR=~/.claude/skills
# NOVABOT_CODEX_SKILLS_DIR=~/.codex/skills
# Extra skill folders to list in the catalog (colon-separated).
# NOVABOT_SKILL_DIRS=
# Keys asked by registry connectors (added here by the catalog when you install them):
# STRIPE_SECRET_KEY=
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------- migrate from Hermes Agent / OpenBot — optional
# Everything below is read once, read-only, and silently skipped when the paths do not exist.
# Hermes Agent home (SOUL.md, memories/, project-memory/, skills/, cron/jobs.json). Default ~/.hermes
# NOVABOT_IMPORT_HERMES_DIR=
# NOVABOT_IMPORT_HERMES_SKILLS=      # default: $NOVABOT_IMPORT_HERMES_DIR/skills
# OpenBot project sheets (markdown, comma-separated) and handoff folders (comma-separated).
# NOVABOT_IMPORT_OPENBOT_SETUP=/var/lib/openbot/openbot-setup.md
# NOVABOT_IMPORT_OPENBOT_HANDOFFS=/var/lib/openbot/handoffs
# NOVABOT_IMPORT_OPENBOT_SKILLS=/var/lib/openbot/.agents/skills
# Also import your user crontab as disabled crons, for review.
# NOVABOT_IMPORT_CRONTAB=1
